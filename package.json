{
  "name": "hayase-nzbgeek",
  "version": "0.1.0",
  "description": "Hayase NZB extension for NZBGeek (Newznab API).",
  "private": true,
  "type": "module",
  "main": "index.json",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/unit.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:network": "node --test tests/network.test.mjs",
    "test:all": "npm run build && node --test tests/unit.test.mjs tests/network.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
